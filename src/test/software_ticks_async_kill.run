source `dirname $0`/util.sh
# A kill lands in the syscallbuf's commit window in only some runs, so kill at
# several delays and replay each recording.
for delay in 0 0.01 0.02 0.03 0.05 0.07 0.1 0.13 0.16 0.2; do
  rm -f record.out
  record $TESTNAME &
  until grep -q ready record.out 2>/dev/null; do
    sleep 0.01
  done
  sleep $delay
  kill -KILL $(pidof $TESTNAME-$nonce)
  wait
  replay
  if ! just_check_record 'EXIT-SUCCESS' || ! just_check_replay_err ||
     ! just_check_record_replay_match; then
    exit
  fi
done
passed
