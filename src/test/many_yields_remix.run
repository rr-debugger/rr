source `dirname $0`/util.sh

exe=many_yields$bitness
cp ${OBJDIR}/bin/$exe $exe-$nonce
just_record $exe-$nonce
rr remix --export-checkpoints=500,2,socket1 NullTool latest-trace &
rr remix --import-checkpoint=socket1 --export-checkpoints=601,1,socket2 NullTool latest-trace &
rr remix --import-checkpoint=socket2 NullTool latest-trace || failed "rerun from 601 failed"
rr remix --import-checkpoint=socket1 NullTool latest-trace || failed "rerun from 500 failed"
wait %1 || failed "First rerun failed"
wait %2 || failed "Second rerun failed"
echo EXIT-SUCCESS
